# Copy this file to .env and fill in the values.

# --- Your public address (HTTPS) where this server runs, no trailing slash ---
BASE_URL=https://your-hotel-bot.example.com

# --- Owner dashboard login ---
ADMIN_PASSWORD=choose-a-strong-password
# Any long random text (keeps you logged in securely)
SESSION_SECRET=replace-with-a-long-random-string

# --- Facebook / Meta (from developers.facebook.com, see README step 3) ---
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
# You invent this; paste the same value in the Meta webhook settings
FB_VERIFY_TOKEN=my-hotel-verify-123
FB_GRAPH_VERSION=v23.0

# --- AI (from console.anthropic.com) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 = best quality for Khmer + bookings. claude-haiku-5-5 = cheapest.
AI_MODEL=claude-sonnet-5-5

# --- Optional: instant alerts on your phone via Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TIMEZONE=Asia/Phnom_Penh
# Where the database and uploaded photos are stored (use a persistent disk in production)
DATA_DIR=./data
